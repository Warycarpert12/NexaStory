---
const { tag, title, excerpt, date, readTime } = Astro.props;
import { siteConfig } from '../config/site.js';
---

<div class="bg-surface rounded-lg overflow-hidden shadow-md hover:shadow-lg transition-shadow duration-300">
  <!-- Placeholder image -->
  <div class="w-full h-48 bg-surfaceAlt flex items-center justify-center">
    <svg xmlns="http://www.w3.org/2000/svg" class="h-12 w-12 text-textMuted" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
    </svg>
  </div>
  
  <div class="p-6">
    <div class="flex items-center mb-3">
      <span class="px-3 py-1 bg-accent text-bg text-xs font-semibold rounded-full">{tag}</span>
    </div>
    
    <h3 class="text-xl font-serif font-semibold text-text mb-2">{title}</h3>
    
    <p class="text-textMuted mb-4">{excerpt}</p>
    
    <div class="flex justify-between items-center text-sm text-textFaint">
      <span>{date}</span>
      <span>{readTime} min read</span>
    </div>
  </div>
</div>